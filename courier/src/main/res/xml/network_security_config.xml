<?xml version="1.0" encoding="utf-8"?>
<!--
  The tablet asks this app to download whatever the owner chose to download, and some of those links are plain http://. Cleartext is therefore allowed;
  what the app will fetch is limited in code instead (no addresses on private networks, see Ssrf). Only system CAs are trusted.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
