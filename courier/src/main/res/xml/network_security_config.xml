<?xml version="1.0" encoding="utf-8"?>
<!--
  A browser must be able to load http:// pages (LAN devices, old sites). Safety does not come from forbidding cleartext here but from
  the HTTPS-first policy in code (upgrade + warning screen), which is stricter than any static config could be.
  Only system CAs are trusted (user-installed CAs are NOT), which is the Android default for apps targeting API 24+.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
