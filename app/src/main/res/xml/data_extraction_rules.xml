<?xml version="1.0" encoding="utf-8"?>
<!-- Backup is disabled app-wide (android:allowBackup="false"); these rules also exclude everything from Android 12+ cloud backup
     and device-to-device transfer, so cookies, history and saved sessions never leave the tablet. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
