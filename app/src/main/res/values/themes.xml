<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework-only theme (no AppCompat/Material). Dark only, no window animations anywhere. -->
    <style name="Theme.Kestrel" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:alertDialogTheme">@style/Theme.Kestrel.Alert</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <!-- the starting window of a cold start (shield on black); the activity swaps in the plain black background in onCreate -->
        <item name="android:windowBackground">@drawable/launch_window</item>
        <item name="android:statusBarColor">@color/chrome_bg</item>
        <item name="android:navigationBarColor">@color/chrome_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Our native UI is already dark; do not let the OS "force dark" re-colour it a second time. -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:textColorPrimary">@color/chrome_fg</item>
        <item name="android:textColorSecondary">@color/chrome_fg_muted</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
    <!-- Alert dialogs without the framework's pop-in animation. -->
    <style name="Theme.Kestrel.Alert" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
