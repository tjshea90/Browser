<?xml version="1.0" encoding="utf-8"?>
<!-- The window Android draws the moment the icon is tapped, before this process has run a line of code (a cold start loads a 118 MB engine: seconds). Black with the app's OWN symbol (the shield with the falcon of
     the icon in the app drawer: the icon's foreground layer, SP1 owner message 41) instead of an empty black screen. 148 dp is the 108 dp icon canvas grown so that the artwork itself is about 96 dp tall, the size LaunchLogo
     draws it at over the first frame of the app (it glows for a moment there). BrowserActivity.onCreate puts the plain black window background back so the symbol is never visible behind a page or a panel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/window_bg" />
    <item android:drawable="@drawable/ic_launcher_foreground" android:gravity="center" android:width="148dp" android:height="148dp" />
</layer-list>
