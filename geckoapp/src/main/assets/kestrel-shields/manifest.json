        "https://*.funcaptcha.com/*",
        "https://*.captcha-delivery.com/*",
        "https://*.perimeterx.net/*",
        "https://*.px-cloud.net/*"
      ],
      "js": [
        "gate-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
