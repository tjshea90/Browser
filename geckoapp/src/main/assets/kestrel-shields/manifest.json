{
  "manifest_version": 2,
  "name": "Kestrel Shields",
  "version": "1.0.177",
  "description": "Ad and tracker blocking plus element hiding for Kestrel G, powered by the app's own filter engine (EasyList, EasyPrivacy, uBlock lists).",
  "browser_specific_settings": {
    "gecko": {
      "id": "shields@kestrel.local"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "geckoViewAddons",
    "http://*/*",
    "https://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "content_security_policy": "script-src 'self'; object-src 'none'",
  "background": {
    "scripts": [
      "engine.js",
      "redirects.js",
      "hlscap.js",
      "background.js"
    ]
  },
  "web_accessible_resources": [
    "embed.html",
    "embed.js"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://challenges.cloudflare.com/*",
        "https://*.hcaptcha.com/*",
        "https://www.google.com/recaptcha/*",
        "https://www.recaptcha.net/recaptcha/*",
        "https://*.arkoselabs.com/*",
        "https://*.funcaptcha.com/*",
        "https://*.captcha-delivery.com/*",
        "https://*.perimeterx.net/*",
        "https://*.px-cloud.net/*"
      ],
      "js": [
        "vfind.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://challenges.cloudflare.com/*",
        "https://*.hcaptcha.com/*",
        "https://www.google.com/recaptcha/*",
        "https://www.recaptcha.net/recaptcha/*",
        "https://*.arkoselabs.com/*",
        "https://*.funcaptcha.com/*",
        "https://*.captcha-delivery.com/*",
        "https://*.perimeterx.net/*",
        "https://*.px-cloud.net/*"
      ],
      "js": [
        "guard-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://challenges.cloudflare.com/*",
